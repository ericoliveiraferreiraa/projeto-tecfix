        <mxCell id="title" value="TECHFIX — MODELO CONCEITUAL (DER)&amp;#10;Versão final consolidada — entidades, atributos e relacionamentos" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
